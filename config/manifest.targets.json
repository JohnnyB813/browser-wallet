{
  "chromium": {
    "manifest": {
      "background": {
        "service_worker": "background.js"
      },
      "side_panel": {
        "default_path": "index.html?sidepanel=1"
      }
    },
    "addPermissions": ["sidePanel"]
  },
  "firefox": {
    "manifest": {
      "background": {
        "scripts": ["background.js"]
      },
      "browser_specific_settings": {
        "gecko": {
          "id": "contact@warthog.network",
          "data_collection_permissions": {
            "required": ["none"]
          }
        }
      }
    },
    "addPermissions": []
  }
}
