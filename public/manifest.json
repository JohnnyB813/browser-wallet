{
  "manifest_version": 3,
  "name": "WARTHOG NETWORK",
"version": "1.2.12",
  "description": "Warthog Network browser wallet — mainnet + DeFi testnet support, secure WART transfers, and account management.",
  "icons": {
    "16": "/logo-16.png",
    "32": "/logo-32.png",
    "48": "/logo-48.png",
    "128": "/logo-128.png"
  },
  "action": {
    "default_title": "WARTHOG NETWORK",
    "default_popup": "index.html",
    "default_icon": {
      "16": "/logo-16.png",
      "32": "/logo-32.png"
    }
  },
  "side_panel": {
    "default_path": "index.html?sidepanel=1"
  },
  "permissions": ["tabs", "storage", "scripting", "activeTab", "cookies", "windows", "sidePanel"],
  "host_permissions": [
    "https://warthognode.duckdns.org/*",
    "https://warthog-defitestnet.duckdns.org/*",
    "https://warthog-defitestnet.duckdns.org:4445/*",
    "https://wartscan.io/*",
    "https://api.coingecko.com/*",
    "https://api.coinpaprika.com/*",
    "http://104.251.219.14:3001/*",
    "http://65.87.7.86:3002/*",
    "http://85.56.145.106:3001/*",
    "http://209.127.34.202:3001/*",
    "*://*/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "options_page": "index.html",
  "homepage_url": "https://wartscan.io/",
  "browser_specific_settings": {
    "gecko": {
      "id": "contact@warthog.network"
    }
  },
  "background": {
    "scripts": ["background.js"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-script.js"],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content-script.js"],
      "matches": ["<all_urls>"]
    }
  ]
}